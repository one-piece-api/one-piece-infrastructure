# Template per .env.local (radice del repo, escluso da git - pattern
# ".env.*" in .gitignore). Copia questo file in .env.local e valorizza le
# variabili: viene caricato automaticamente da scripts/lib/load-env-local.sh
# in ogni script locale (setup.sh, helmfile sync diretto, singoli hook) -
# nessun "export" manuale da ripetere ad ogni sessione di shell. Stesso
# spirito di oauth2-proxy/secret.local.yaml per gli altri segreti locali di
# questo repo.
#
#   cp .env.local.example .env.local
#   # poi valorizza le variabili sotto

# Obbligatoria in ogni ambiente, locale incluso - vedi
# docs/adr/0007-resend-only-email-delivery.md. Verificata da
# scripts/00-check-prerequisites.sh prima di creare qualunque cosa.
RESEND_API_KEY=

# Opzionale in locale (ambiente "default": nessun pull da registry, le
# immagini sono costruite a mano - ADR-0003). Serve solo per sincronizzare
# manualmente l'ambiente "ci" da una macchina locale, es. per debugging
# (HELMFILE_ENVIRONMENT=ci helmfile sync) - vedi
# docs/adr/0004-ci-images-from-ghcr.md.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=
