# Orchestrazione dichiarativa dello stack di autenticazione locale (kind).
#
# Sostituisce gli ex script scripts/02-06: le dipendenze tra i componenti
# sono esplicite (needs:) invece di essere codificate nell'ordine di uno
# script bash, e l'attesa di readiness usa --wait nativo di Helm invece di
# un wait_for_pod scritto a mano (che in questo stesso repo ha già causato
# un timeout troppo stretto e una race condition — vedi
# docs/adr/0002-helmfile-orchestration.md).
#
# Uso (dalla root del repository):
#   helmfile sync     # applica tutto da zero o aggiorna: nessun plugin richiesto
#   helmfile apply     # come sync, ma calcola prima un diff (richiede il
#                       # plugin helm-diff: helm plugin install
#                       # https://github.com/databus23/helm-diff)
#   helmfile destroy   # rimuove tutte le release (il cluster kind va comunque
#                       # eliminato a parte con scripts/teardown.sh)
#   helmfile graph      # stampa il grafo delle dipendenze (needs:)

repositories:
  - name: codecentric
    url: https://codecentric.github.io/helm-charts
  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests
  # Chart di Envoy Gateway, pubblicati come artefatti OCI su Docker Hub
  # (ADR-0019).
  - name: envoyproxy
    url: docker.io/envoyproxy
    oci: true
  # cert-manager, solo nell'ambiente "remote" (ADR-0021).
  - name: jetstack
    url: https://charts.jetstack.io

# Due ambienti: "default" (sviluppo locale, invariato) e "ci" (CI di questo
# repo, vedi .github/workflows/test-infrastructure.yml). In locale
# user-service/user-frontend restano costruiti a mano e caricati con
# "kind load docker-image" (ADR-0003): nessuna immagine di registry, nessun
# pull secret. In "ci" puntano invece alle immagini pubblicate su GHCR dai
# rispettivi repository applicativi, cosa che rende possibile un check
# infrastrutturale end-to-end reale (stesse immagini che finirebbero in un
# deploy vero), non solo lo scaffolding dei manifest — vedi ADR-0004.
environments:
  default:
    values:
      - userServiceImage: ""
        userServiceImagePullPolicy: ""
        userFrontendImage: ""
        userFrontendImagePullPolicy: ""
        contentServiceImage: ""
        contentServiceImagePullPolicy: ""
        publicApiImage: ""
        publicApiImagePullPolicy: ""
        keycloakImageRepository: ""
        keycloakImageTag: ""
        keycloakImagePullPolicy: ""
        imagePullSecrets: []
        invitationTokenLifespan: ""
  ci:
    values:
      - userServiceImage: ghcr.io/one-piece-api/user-service:latest
        userServiceImagePullPolicy: Always
        userFrontendImage: ghcr.io/one-piece-api/user-frontend:latest
        userFrontendImagePullPolicy: Always
        contentServiceImage: ghcr.io/one-piece-api/content-service:latest
        contentServiceImagePullPolicy: Always
        publicApiImage: ghcr.io/one-piece-api/public-api:latest
        publicApiImagePullPolicy: Always
        # Tema custom (docs/adr/0010-custom-keycloak-theme.md), stessa
        # origine GHCR delle altre immagini applicative.
        keycloakImageRepository: ghcr.io/one-piece-api/keycloak-theme
        keycloakImageTag: latest
        keycloakImagePullPolicy: Always
        # I package GHCR sono privati di default: questo Secret (creato
        # dall'hook presync di ciascuna release, script
        # scripts/create-ghcr-pull-secret.sh) è necessario per il pull.
        imagePullSecrets:
          - name: ghcr-pull-secret
        # PT5S invece del PT12H di produzione (application.properties): solo
        # questo ambiente lo consuma one-piece-e2e, che deve raggiungere
        # INVITATION_EXPIRED (Step 5, UF-IDU-03) in un run di pochi minuti,
        # non attendere 12h - vedi helm/charts/user-service/values.yaml.
        invitationTokenLifespan: "PT5S"
  remote:
    values:
      # Stessa origine immagini di "ci" (GHCR, ADR-0004): l'ambiente remoto
      # non ha un meccanismo di "kind load docker-image" - vedi ADR-0005.
      # invitationTokenLifespan invariata (default applicativo, non il
      # PT5S usato solo per i test e2e in ci).
      - userServiceImage: ghcr.io/one-piece-api/user-service:latest
        userServiceImagePullPolicy: Always
        userFrontendImage: ghcr.io/one-piece-api/user-frontend:latest
        userFrontendImagePullPolicy: Always
        contentServiceImage: ghcr.io/one-piece-api/content-service:latest
        contentServiceImagePullPolicy: Always
        publicApiImage: ghcr.io/one-piece-api/public-api:latest
        publicApiImagePullPolicy: Always
        keycloakImageRepository: ghcr.io/one-piece-api/keycloak-theme
        keycloakImageTag: latest
        keycloakImagePullPolicy: Always
        imagePullSecrets:
          - name: ghcr-pull-secret
        invitationTokenLifespan: ""
        # Dominio pubblico (ADR-0020/0022): un solo valore da cui derivano
        # certificato e, dallo step I3, gli host app./auth./api.
        publicDomain: onepieceapi.dev
        # ClusterIssuer del certificato del dominio (ADR-0021).
        certificateIssuer: letsencrypt-production

---
# Una sola versione per chart di Envoy Gateway e CRD (hook presync della
# release "envoy-gateway"): devono restare allineate, ADR-0019.
{{ $envoyGatewayVersion := "v1.9.2" }}

# Origin pubblici dell'ambiente "remote" (ADR-0022), derivati una volta sola
# dal dominio: un sottodominio per pubblico (ADR-0020). Fuori da "remote"
# publicDomain non esiste e questi valori non vengono usati.
{{ $publicDomain := .Values | get "publicDomain" "" }}
{{ $appHost := printf "app.%s" $publicDomain }}
{{ $authHost := printf "auth.%s" $publicDomain }}
{{ $apiHost := printf "api.%s" $publicDomain }}
{{ $appOrigin := printf "https://%s" $appHost }}
{{ $authOrigin := printf "https://%s" $authHost }}

helmDefaults:
  wait: true
  # Sempre innocuo (namespace "auth" già esistente dopo il primo sync): ma
  # necessario al primo bootstrap, perché "helm install -n auth" fallisce
  # con "namespace not found" se il namespace non esiste ancora — anche
  # quando il chart stesso crea quel namespace (release "namespace" sotto).
  createNamespace: true

releases:
  - name: namespace
    namespace: auth
    chart: ./helm/charts/namespace
    timeout: 30

{{ if eq .Environment.Name "ci" }}
  # Mock SMTP, solo per "ci": senza un dominio verificato su Resend,
  # l'account può consegnare solo al proprio indirizzo verificato, non agli
  # indirizzi arbitrari @onepiece.local generati dai test e2e - la chiamata
  # SMTP reale restava appesa abbastanza da far scadere anche test non
  # legati alle email. "default" e "remote" restano su Resend reale
  # (ADR-0007) - vedi docs/adr/0008-mock-smtp-in-ci.md.
  - name: mailpit
    namespace: auth
    chart: ./helm/charts/mailpit
    needs:
      - auth/namespace
    timeout: 60
{{ end }}

  # Namespace applicativo, separato da "auth": ospita i servizi di
  # dominio (a partire da user-service/user-frontend), non l'identity
  # provider — vedi docs/user-flows/application-user-identity-management.md
  # nel repo one-piece-api.
  - name: app-namespace
    namespace: app
    chart: ./helm/charts/namespace
    values:
      - name: app
        component: application
    timeout: 30

  # Namespace dei dati, separato sia da "auth" sia da "app": l'istanza
  # PostgreSQL condivisa non appartiene a nessuno dei servizi che la usano.
  - name: data-namespace
    namespace: data
    chart: ./helm/charts/namespace
    values:
      - name: data
        component: database
    timeout: 30

  # Istanza PostgreSQL unica per tutti i servizi, un database + un ruolo
  # proprietario ciascuno (ADR-0016): su OCI ogni volume costa almeno 50 GB
  # della quota Always Free da 200 GB, un'istanza per servizio la sforava.
  # I Secret delle credenziali nascono nel namespace di ciascun consumatore,
  # da cui i needs sui namespace "auth" e "app".
  - name: postgresql
    namespace: data
    chart: ./helm/charts/postgresql
    needs:
      - data/data-namespace
      - auth/namespace
      - app/app-namespace
    values:
      - databases:
          - database: keycloak
            username: keycloak
            password: "keycloak-db-change-me-locally"
            secretNamespace: auth
            secretName: one-piece-keycloak-db-credentials
          - database: user_service
            username: user_service
            password: "user-service-db-change-me-locally"
            secretNamespace: app
            secretName: one-piece-user-service-db-credentials
          - database: content_service
            username: content_service
            password: "content-service-db-change-me-locally"
            secretNamespace: app
            secretName: one-piece-content-service-db-credentials
        # API pubblica: legge solo lo schema "published" di content_service
        # (ADR-0018). Il ruolo deve esistere prima delle migrazioni di
        # content-service, che gli concedono i permessi: "needs" già lo
        # garantisce, il Job gira prima che la release risulti completata.
        readers:
          - username: public_api_reader
            database: content_service
            password: "public-api-reader-db-change-me-locally"
            connectionLimit: 10
            statementTimeout: 2s
            secretNamespace: app
            secretName: one-piece-public-api-db-credentials
{{ if eq .Environment.Name "remote" }}
      # Nodi Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # un DB dev a singolo utente, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 50m
{{ end }}
    # Cold-pull immagine (~170s su rete locale lenta) + readiness + Job di
    # bootstrap, vedi docs/adr/0002-helmfile-orchestration.md.
    timeout: 300

  - name: user-service
    namespace: app
    chart: ./helm/charts/user-service
    needs:
      - app/app-namespace
      - data/postgresql
    values:
      - image: '{{ .Values.userServiceImage | default "one-piece-user-service:local" }}'
        imagePullPolicy: '{{ .Values.userServiceImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
        invitationTokenLifespan: '{{ .Values.invitationTokenLifespan | default "" }}'
{{ if eq .Environment.Name "remote" }}
        # Il claim "iss" nei token riflette l'hostname pubblico di Keycloak
        # (auth., ADR-0022), non "localhost" - vedi
        # helm/charts/user-service/values.yaml. Le chiavi JWKS restano lette
        # dall'indirizzo interno (application-dev.properties).
        jwtIssuerUri: '{{ $authOrigin }}/realms/onepiece'
        # Dove atterra il browser a fine flusso di invito (UPDATE_PASSWORD/
        # UPDATE_PROFILE/VERIFY_EMAIL): il back-office su app.
        invitationRedirectUri: '{{ $appOrigin }}/'
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-user-service:local
      # nel cluster kind (repo sibling one-piece-user-service). No-op in
      # "ci" — vedi scripts/build-and-load-local-image.sh.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-user-service"]
      # Credenziali del client Keycloak "user-service-admin" (Admin API,
      # Step 3 — listing utenti). Nessuna dipendenza da "needs" verso
      # auth/keycloak: legge solo il file locale realm-onepiece.json, non
      # chiama Keycloak — l'autenticazione vera avviene lazy, alla prima
      # chiamata Admin API effettiva.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-user-service-admin-secret.sh"]
    timeout: 120

  - name: user-frontend
    namespace: app
    chart: ./helm/charts/user-frontend
    needs:
      - app/app-namespace
    values:
      - image: '{{ .Values.userFrontendImage | default "one-piece-user-frontend:local" }}'
        imagePullPolicy: '{{ .Values.userFrontendImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # nginx che serve solo asset statici, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 30m
      # Il browser raggiunge Keycloak sul suo sottodominio (auth., ADR-0022),
      # non "localhost:8080" - genera config.json a startup del container
      # (repo one-piece-user-frontend, docs/adr/0001-runtime-config-injection.md).
      - keycloakOrigin: '{{ $authOrigin }}'
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-user-frontend:local
      # nel cluster kind (repo sibling one-piece-user-frontend). No-op in
      # "ci" — vedi scripts/build-and-load-local-image.sh.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-user-frontend"]
    timeout: 60

  # Backend del workflow editoriale contenuti (one-piece-api/docs/implementation-plan-content.md
  # Fase 0) - servizio separato da user-service, con il proprio database
  # nell'istanza condivisa (postgresql sopra), nessuna dipendenza da Keycloak Admin API
  # (solo resource server: valida gli stessi token di user-service, nessun
  # secret/client Keycloak dedicato necessario).
  - name: content-service
    namespace: app
    chart: ./helm/charts/content-service
    needs:
      - app/app-namespace
      - data/postgresql
    values:
      - image: '{{ .Values.contentServiceImage | default "one-piece-content-service:local" }}'
        imagePullPolicy: '{{ .Values.contentServiceImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
        jwtIssuerUri: '{{ $authOrigin }}/realms/onepiece'
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-content-service:local
      # nel cluster kind (repo sibling one-piece-content-service). No-op in
      # "ci" — vedi scripts/build-and-load-local-image.sh.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-content-service"]
    timeout: 120

  # API pubblica in sola lettura (one-piece-api/docs/implementation-plan-public-api.md):
  # legge lo schema "published" di content_service come public_api_reader
  # (ADR-0018). Dipende da content-service perché le viste e i grant nascono
  # dalle sue migrazioni. Nessuna rotta sull'Ingress finché non c'è il
  # percorso pubblico (step P6).
  - name: public-api
    namespace: app
    chart: ./helm/charts/public-api
    needs:
      - app/app-namespace
      - data/postgresql
      - app/content-service
    values:
      - image: '{{ .Values.publicApiImage | default "one-piece-public-api:local" }}'
        imagePullPolicy: '{{ .Values.publicApiImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): nessun traffico pubblico
      # ancora, request minima per lasciare margine agli altri pod.
      - resources:
          requests:
            cpu: 30m
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-public-api:local nel
      # cluster kind (repo sibling one-piece-public-api). No-op in "ci".
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-public-api"]
    timeout: 120

  - name: keycloak
    namespace: auth
    chart: codecentric/keycloakx
    version: 7.2.3
    needs:
      - auth/namespace
      - data/postgresql
{{ if eq .Environment.Name "ci" }}
      - auth/mailpit
{{ end }}
    values:
      - keycloak/values-keycloakx.yaml
      - image:
          repository: '{{ .Values.keycloakImageRepository | default "one-piece-keycloak-theme" }}'
          tag: '{{ .Values.keycloakImageTag | default "local" }}'
          pullPolicy: '{{ .Values.keycloakImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # un Keycloak dev a singolo utente (250m saturava da solo quasi tutta
      # l'unica OCPU disponibile insieme ai pod di sistema OKE).
      - resources:
          requests:
            cpu: 150m
      # "command" è una lista: i values Helm non fondono le liste elemento
      # per elemento, vanno ridichiarate per intero per cambiare solo
      # --hostname. Il browser raggiunge Keycloak su auth. (ADR-0022), non
      # "localhost" - l'issuer nei token deve rifletterlo, altrimenti
      # oauth2-proxy lo rifiuta per mismatch.
      - command:
          - "/opt/keycloak/bin/kc.sh"
          - "start"
          - "--import-realm"
          - '--hostname={{ $authOrigin }}'
          - "--hostname-strict=false"
          # Il TLS termina sul Gateway: Keycloak crede agli header
          # X-Forwarded-* (schema HTTPS, IP del client) solo se arrivano
          # dalla rete dei pod, dove gira il proxy Envoy (il suo IP cambia a
          # ogni riavvio, non si può fissare).
          - "--proxy-headers=xforwarded"
          - "--proxy-trusted-addresses=10.244.0.0/16"
{{ end }}
    # Cold-pull immagine ~250MB (~4min su rete locale lenta) + avvio
    # (schema DB, import realm, ~60-90s in condizioni normali, ma osservato
    # fino a superare 480s sotto carico di sistema sostenuto), vedi
    # docs/adr/0002-helmfile-orchestration.md.
    timeout: 600
    hooks:
      # Analogo agli hook di user-service/user-frontend: Secret di pull GHCR
      # (namespace "auth", qui - i Secret sono namespace-scoped) e build+load
      # locale dell'immagine one-piece-keycloak-theme (repo sibling), no-op
      # fuori dall'ambiente "default" - vedi docs/adr/0010.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh", "auth"]
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-keycloak-theme"]
      # La ConfigMap del realm deve esistere ed essere aggiornata prima che
      # il chart venga sincronizzato, perché Keycloak la monta e la importa
      # all'avvio (--import-realm).
      - events: ["presync"]
        command: "bash"
        args: ["scripts/apply-realm-configmap.sh"]
      # Riconcilia il realm con realm-onepiece.json via keycloak-config-cli:
      # "--import-realm" da solo crea le entità mancanti ma non aggiorna un
      # realm già esistente (bug noto, vedi il commento in apply-realm-configmap.sh)
      # - questo hook chiude quel gap per ogni futura modifica al realm
      # dichiarativo, non solo per quelle già note ai tre hook sotto (che
      # restano per SMTP/redirect URI specifici dell'ambiente, non presenti
      # nel JSON) - vedi docs/adr/0011-keycloak-config-cli-realm-sync.md.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/sync-realm-config.sh"]
      # Il realm importato punta già all'host SMTP di Resend (vedi
      # keycloak/realm-onepiece.json), ma senza credenziale - un segreto non
      # va committato. Questo hook imposta la password (RESEND_API_KEY) via
      # Admin API dopo l'import in "default"/"remote" (ADR-0007); in "ci"
      # punta invece il realm a Mailpit (ADR-0008) - a differenza dell'hook
      # sopra, qui serve Keycloak già pronto.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-realm-smtp.sh"]
      # Restringe il permesso di modifica di "email" al solo ADMIN sullo
      # User Profile (vedi scripts/configure-user-profile.sh) - stesso
      # motivo dell'hook sopra: non affidabile via import del realm.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-user-profile.sh"]
      # Solo in "remote": il redirect URI del client "onepiece-proxy" nel
      # realm importato resta fisso su "localhost" - va corretto per app.
      # (ADR-0022) via Admin API (stesso motivo dei due hook sopra:
      # "--import-realm" non aggiorna un client già esistente).
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-remote-redirect-uris.sh", "{{ $appOrigin }}"]
      # Porta i permessi roles:read/roles:assign/roles:manage e i grant del
      # service account in linea con realm-onepiece.json su un realm già
      # esistente (stesso motivo dei tre hook sopra) - vedi il commento in
      # testa allo script per il dettaglio di cosa corregge e perché.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-role-catalog-permissions.sh"]
      # Catalogo permessi del dominio contenuti (content:*, languages:manage,
      # ruolo PUBLISHER) - vedi il commento in testa allo script per cosa provisiona
      # e perché (stesso principio del hook sopra, per un dominio diverso).
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-content-permissions.sh"]
      # Account di prova per il workflow editoriale, dopo l'hook sopra perché
      # usano il ruolo PUBLISHER che quello crea. Anche in "remote", che è un
      # ambiente di sviluppo come gli altri.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/seed-content-qa-users.sh"]

  - name: redis
    namespace: auth
    chart: ./helm/charts/redis
    needs:
      - auth/namespace
{{ if eq .Environment.Name "remote" }}
    values:
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # una cache che idle a consumo bassissimo, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 30m
{{ end }}
    # Backing store del session storage di oauth2-proxy (ADR-0009): niente
    # cold-pull pesante né readiness lenta, un'immagine alpine minuscola.
    timeout: 60

  - name: oauth2-proxy
    namespace: auth
    chart: oauth2-proxy/oauth2-proxy
    version: 10.7.0
    needs:
      - auth/namespace
      - auth/keycloak
      - auth/redis
      - app/user-service
      - app/user-frontend
      - app/content-service
    values:
      - oauth2-proxy/values-oauth2-proxy.yaml
{{ if eq .Environment.Name "remote" }}
      # Il browser raggiunge oauth2-proxy su app. e Keycloak su auth.
      # (ADR-0022), non "localhost" - solo i campi con cui il browser
      # interagisce direttamente cambiano; redeem-url/oidc-jwks-url restano
      # sul DNS interno (chiamate server-to-server, invariate).
      - extraArgs:
          oidc-issuer-url: '{{ $authOrigin }}/realms/onepiece'
          login-url: '{{ $authOrigin }}/realms/onepiece/protocol/openid-connect/auth'
          redirect-url: '{{ $appOrigin }}/oauth2/callback'
          whitelist-domain: '{{ $authHost }}'
          # Solo HTTPS (dominio .dev, HSTS preload): il cookie di sessione
          # non viaggia mai in chiaro.
          cookie-secure: "true"
{{ end }}
    timeout: 180
    hooks:
      # Il Secret con client-id/client-secret/cookie-secret deve esistere
      # prima del sync: i values referenziano config.existingSecret.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/generate-oauth2-proxy-secret.sh"]

  # Ingresso pubblico (ADR-0019): Gateway API con Envoy Gateway, al posto di
  # ingress-nginx (dismesso da Kubernetes a marzo 2026). Come prima, il
  # Load Balancer reale ha senso solo in "remote", ma le release restano
  # definite per tutti gli ambienti: in "default"/"ci" il Service resta
  # <pending> e l'accesso continua via kubectl port-forward.
  - name: gateway-namespace
    namespace: envoy-gateway-system
    chart: ./helm/charts/namespace
    values:
      - name: envoy-gateway-system
        component: ingress
    timeout: 30

  # Controller di Envoy Gateway: legge Gateway/HTTPRoute e crea il proxy
  # Envoy (Deployment + Service LoadBalancer) descritto dalla release
  # "gateway" sotto.
  - name: envoy-gateway
    namespace: envoy-gateway-system
    chart: envoyproxy/gateway-helm
    version: {{ $envoyGatewayVersion }}
    needs:
      - envoy-gateway-system/gateway-namespace
    values:
      # CRD gestite dall'hook presync sotto, non dal chart (che non le
      # aggiornerebbe mai, vedi scripts/apply-gateway-crds.sh).
      - crds:
          enabled: false
        # Request ridotte per il budget Always Free (ADR-0005): i default
        # del chart (100m/256Mi) da soli occupano un quarto della CPU
        # schedulabile rimasta sul cluster remoto.
        deployment:
          envoyGateway:
            resources:
              requests:
                cpu: 30m
                memory: 128Mi
              limits:
                memory: 512Mi
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/apply-gateway-crds.sh", "{{ $envoyGatewayVersion }}"]
    timeout: 180

  - name: gateway
    namespace: envoy-gateway-system
    chart: ./helm/charts/gateway
    needs:
      - envoy-gateway-system/envoy-gateway
{{ if eq .Environment.Name "remote" }}
    values:
      - service:
          annotations:
            # Always Free: un solo Flexible Load Balancer per tenancy,
            # banda 10 Mbps fissa (min = max) - un max diverso da 10
            # provisiona un LB a pagamento. Vedi docs/adr/0005.
            service.beta.kubernetes.io/oci-load-balancer-shape: "flexible"
            service.beta.kubernetes.io/oci-load-balancer-shape-flex-min: "10"
            service.beta.kubernetes.io/oci-load-balancer-shape-flex-max: "10"
            # Con la topologia a subnet unica (network.tf) il
            # cloud-controller-manager OCI non riesce a dedurla da sé
            # ("a subnet must be specified") - va data esplicitamente.
            # Valore: terraform output -raw subnet_id (terraform/).
            service.beta.kubernetes.io/oci-load-balancer-subnet1: '{{ env "OCI_LB_SUBNET_ID" | default "" }}'
            # IP pubblico riservato (network.tf): gli URL OAuth2 di
            # oauth2-proxy/Keycloak devono puntare a un indirizzo noto in
            # anticipo, non a quello assegnato dinamicamente alla creazione
            # del LB. Valore: terraform output -raw lb_ip.
            oci.oraclecloud.com/reserved-ips: '{{ env "OCI_LB_IP" | default "" }}'
            # Senza questo, il cloud-controller-manager OCI gestisce da sé
            # la security list della subnet e aggiunge le sue regole
            # aperte (0.0.0.0/0) per le porte del Service - annullando la
            # restrizione al solo CIDR autorizzato che imponiamo via
            # Terraform (network.tf). "None" lascia la security list
            # interamente a noi.
            service.beta.kubernetes.io/oci-load-balancer-security-list-management-mode: "None"
        # HTTPS con il certificato del dominio (release "certificates").
        https:
          enabled: true
          certificateSecretName: public-domain-tls
        # IP reale del client da Cloudflare (ADR-0020).
        clientIPHeader: CF-Connecting-IP
{{ end }}
    timeout: 120

{{ if eq .Environment.Name "remote" }}
  # HTTPS dell'origin (ADR-0021): cert-manager chiede a Let's Encrypt il
  # certificato del dominio con verifica DNS-01 su Cloudflare e lo rinnova
  # da solo. Solo in "remote": locale e CI non hanno dominio.
  - name: cert-manager-namespace
    namespace: cert-manager
    chart: ./helm/charts/namespace
    values:
      - name: cert-manager
        component: certificates
    timeout: 30

  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.21.2
    needs:
      - cert-manager/cert-manager-namespace
    values:
      # CRD come template del chart: Helm le aggiorna a ogni upgrade, e
      # "keep" le conserva (con i certificati) se la release viene rimossa.
      - crds:
          enabled: true
          keep: true
        # Request ridotte per il budget Always Free (ADR-0005): i default del
        # chart non ne impostano, ma lo scheduler deve poterli contare.
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
          limits:
            memory: 192Mi
        webhook:
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 96Mi
        cainjector:
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 192Mi
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-cloudflare-dns-token-secret.sh"]
    timeout: 180

  - name: certificates
    namespace: cert-manager
    chart: ./helm/charts/certificates
    needs:
      - cert-manager/cert-manager
      - envoy-gateway-system/gateway-namespace
    values:
      - domain: {{ .Values.publicDomain }}
        issuer: {{ .Values.certificateIssuer }}
    # --wait attende il certificato emesso: la prima emissione (o un cambio
    # di issuer) con DNS-01 richiede la propagazione del record TXT, osservata
    # oltre i 60s (2026-10-06). A regime i rinnovi avvengono in background,
    # con il Secret esistente ancora valido: nessuna attesa.
    timeout: 300
{{ end }}

  - name: oauth2-proxy-route
    namespace: auth
    chart: ./helm/charts/http-route
    needs:
      - auth/oauth2-proxy
      - envoy-gateway-system/gateway
{{ if eq .Environment.Name "remote" }}
    values:
      # Back-office su app. (ADR-0020): oauth2-proxy instrada già
      # frontend/backend (config.upstreams).
      - hostnames:
          - {{ $appHost }}
{{ end }}
    timeout: 30

{{ if eq .Environment.Name "remote" }}
  # Login su auth. (ADR-0020): il browser raggiunge Keycloak durante il flow
  # OAuth2 (redirect su /realms, risorse del tema su /resources). La console
  # admin (/admin) resta non esposta: si usa via kubectl port-forward.
  - name: keycloak-route
    namespace: auth
    chart: ./helm/charts/http-route
    needs:
      - auth/keycloak
      - envoy-gateway-system/gateway
    values:
      - name: keycloak
        hostnames:
          - {{ $authHost }}
        paths:
          - path: /realms
            backendServiceName: keycloak-http
            backendServicePort: 8080
          - path: /resources
            backendServiceName: keycloak-http
            backendServicePort: 8080
    timeout: 30

  # Dominio principale -> API pubblica (ADR-0020). 302, non 301: il
  # dominio diventerà la vetrina dell'API, i browser non devono memorizzare
  # il redirect come permanente.
  - name: apex-route
    namespace: app
    chart: ./helm/charts/http-route
    needs:
      - app/app-namespace
      - envoy-gateway-system/gateway
    values:
      - name: apex
        namespace: app
        component: application
        hostnames:
          - {{ $publicDomain }}
        paths:
          - path: /
            redirect:
              hostname: {{ $apiHost }}
              statusCode: 302
    timeout: 30
{{ end }}
