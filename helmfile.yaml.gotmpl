# Orchestrazione dichiarativa dello stack di autenticazione locale (kind).
#
# Sostituisce gli ex script scripts/02-06: le dipendenze tra i componenti
# sono esplicite (needs:) invece di essere codificate nell'ordine di uno
# script bash, e l'attesa di readiness usa --wait nativo di Helm invece di
# un wait_for_pod scritto a mano (che in questo stesso repo ha già causato
# un timeout troppo stretto e una race condition — vedi
# docs/adr/0002-helmfile-orchestration.md).
#
# Uso (dalla root del repository):
#   helmfile sync     # applica tutto da zero o aggiorna: nessun plugin richiesto
#   helmfile apply     # come sync, ma calcola prima un diff (richiede il
#                       # plugin helm-diff: helm plugin install
#                       # https://github.com/databus23/helm-diff)
#   helmfile destroy   # rimuove tutte le release (il cluster kind va comunque
#                       # eliminato a parte con scripts/teardown.sh)
#   helmfile graph      # stampa il grafo delle dipendenze (needs:)

repositories:
  - name: codecentric
    url: https://codecentric.github.io/helm-charts
  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

# Due ambienti: "default" (sviluppo locale, invariato) e "ci" (CI di questo
# repo, vedi .github/workflows/test-infrastructure.yml). In locale
# user-service/user-frontend restano costruiti a mano e caricati con
# "kind load docker-image" (ADR-0003): nessuna immagine di registry, nessun
# pull secret. In "ci" puntano invece alle immagini pubblicate su GHCR dai
# rispettivi repository applicativi, cosa che rende possibile un check
# infrastrutturale end-to-end reale (stesse immagini che finirebbero in un
# deploy vero), non solo lo scaffolding dei manifest — vedi ADR-0004.
environments:
  default:
    values:
      - userServiceImage: ""
        userServiceImagePullPolicy: ""
        userFrontendImage: ""
        userFrontendImagePullPolicy: ""
        keycloakImageRepository: ""
        keycloakImageTag: ""
        keycloakImagePullPolicy: ""
        imagePullSecrets: []
        invitationTokenLifespan: ""
  ci:
    values:
      - userServiceImage: ghcr.io/one-piece-api/user-service:latest
        userServiceImagePullPolicy: Always
        userFrontendImage: ghcr.io/one-piece-api/user-frontend:latest
        userFrontendImagePullPolicy: Always
        # Tema custom (docs/adr/0010-custom-keycloak-theme.md), stessa
        # origine GHCR delle altre immagini applicative.
        keycloakImageRepository: ghcr.io/one-piece-api/keycloak-theme
        keycloakImageTag: latest
        keycloakImagePullPolicy: Always
        # I package GHCR sono privati di default: questo Secret (creato
        # dall'hook presync di ciascuna release, script
        # scripts/create-ghcr-pull-secret.sh) è necessario per il pull.
        imagePullSecrets:
          - name: ghcr-pull-secret
        # PT5S invece del PT12H di produzione (application.properties): solo
        # questo ambiente lo consuma one-piece-e2e, che deve raggiungere
        # INVITATION_EXPIRED (Step 5, UF-IDU-03) in un run di pochi minuti,
        # non attendere 12h - vedi helm/charts/user-service/values.yaml.
        invitationTokenLifespan: "PT5S"
  remote:
    values:
      # Stessa origine immagini di "ci" (GHCR, ADR-0004): l'ambiente remoto
      # non ha un meccanismo di "kind load docker-image" - vedi ADR-0005.
      # invitationTokenLifespan invariata (default applicativo, non il
      # PT5S usato solo per i test e2e in ci).
      - userServiceImage: ghcr.io/one-piece-api/user-service:latest
        userServiceImagePullPolicy: Always
        userFrontendImage: ghcr.io/one-piece-api/user-frontend:latest
        userFrontendImagePullPolicy: Always
        keycloakImageRepository: ghcr.io/one-piece-api/keycloak-theme
        keycloakImageTag: latest
        keycloakImagePullPolicy: Always
        imagePullSecrets:
          - name: ghcr-pull-secret
        invitationTokenLifespan: ""

---
helmDefaults:
  wait: true
  # Sempre innocuo (namespace "auth" già esistente dopo il primo sync): ma
  # necessario al primo bootstrap, perché "helm install -n auth" fallisce
  # con "namespace not found" se il namespace non esiste ancora — anche
  # quando il chart stesso crea quel namespace (release "namespace" sotto).
  createNamespace: true

releases:
  - name: namespace
    namespace: auth
    chart: ./helm/charts/namespace
    timeout: 30

  - name: postgresql
    namespace: auth
    chart: ./helm/charts/postgresql
    needs:
      - auth/namespace
{{ if eq .Environment.Name "remote" }}
    values:
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # un DB dev a singolo utente, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 50m
{{ end }}
    # Cold-pull immagine (~170s su rete locale lenta) + readiness, vedi
    # docs/adr/0002-helmfile-orchestration.md.
    timeout: 240

{{ if eq .Environment.Name "ci" }}
  # Mock SMTP, solo per "ci": senza un dominio verificato su Resend,
  # l'account può consegnare solo al proprio indirizzo verificato, non agli
  # indirizzi arbitrari @onepiece.local generati dai test e2e - la chiamata
  # SMTP reale restava appesa abbastanza da far scadere anche test non
  # legati alle email. "default" e "remote" restano su Resend reale
  # (ADR-0007) - vedi docs/adr/0008-mock-smtp-in-ci.md.
  - name: mailpit
    namespace: auth
    chart: ./helm/charts/mailpit
    needs:
      - auth/namespace
    timeout: 60
{{ end }}

  # Namespace applicativo, separato da "auth": ospita i servizi di
  # dominio (a partire da user-service/user-frontend), non l'identity
  # provider — vedi docs/user-flows/application-user-identity-management.md
  # nel repo one-piece-api.
  - name: app-namespace
    namespace: app
    chart: ./helm/charts/namespace
    values:
      - name: app
        component: application
    timeout: 30

  - name: app-postgresql
    namespace: app
    chart: ./helm/charts/postgresql
    needs:
      - app/app-namespace
    values:
      - namespace: app
        component: application
        name: one-piece-app-postgresql
        database: user_service
        username: user_service
        secretName: one-piece-app-postgresql-credentials
        password: "user-service-db-change-me-locally"
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # un DB dev a singolo utente, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 50m
{{ end }}
    timeout: 240

  - name: user-service
    namespace: app
    chart: ./helm/charts/user-service
    needs:
      - app/app-namespace
      - app/app-postgresql
    values:
      - image: '{{ .Values.userServiceImage | default "one-piece-user-service:local" }}'
        imagePullPolicy: '{{ .Values.userServiceImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
        invitationTokenLifespan: '{{ .Values.invitationTokenLifespan | default "" }}'
{{ if eq .Environment.Name "remote" }}
        # Il claim "iss" nei token riflette l'hostname pubblico di Keycloak
        # (IP riservato, network.tf), non più "localhost" - vedi
        # helm/charts/user-service/values.yaml.
        jwtIssuerUri: 'http://{{ env "OCI_LB_IP" | default "localhost:8080" }}/realms/onepiece'
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-user-service:local
      # nel cluster kind (repo sibling one-piece-user-service). No-op in
      # "ci" — vedi scripts/build-and-load-local-image.sh.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-user-service"]
      # Credenziali del client Keycloak "user-service-admin" (Admin API,
      # Step 3 — listing utenti). Nessuna dipendenza da "needs" verso
      # auth/keycloak: legge solo il file locale realm-onepiece.json, non
      # chiama Keycloak — l'autenticazione vera avviene lazy, alla prima
      # chiamata Admin API effettiva.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-user-service-admin-secret.sh"]
    timeout: 120

  - name: user-frontend
    namespace: app
    chart: ./helm/charts/user-frontend
    needs:
      - app/app-namespace
    values:
      - image: '{{ .Values.userFrontendImage | default "one-piece-user-frontend:local" }}'
        imagePullPolicy: '{{ .Values.userFrontendImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # nginx che serve solo asset statici, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 30m
{{ end }}
    hooks:
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh"]
      # Ambiente "default": builda e carica one-piece-user-frontend:local
      # nel cluster kind (repo sibling one-piece-user-frontend). No-op in
      # "ci" — vedi scripts/build-and-load-local-image.sh.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-user-frontend"]
    timeout: 60

  - name: keycloak
    namespace: auth
    chart: codecentric/keycloakx
    version: 7.2.3
    needs:
      - auth/namespace
      - auth/postgresql
{{ if eq .Environment.Name "ci" }}
      - auth/mailpit
{{ end }}
    values:
      - keycloak/values-keycloakx.yaml
      - image:
          repository: '{{ .Values.keycloakImageRepository | default "one-piece-keycloak-theme" }}'
          tag: '{{ .Values.keycloakImageTag | default "local" }}'
          pullPolicy: '{{ .Values.keycloakImagePullPolicy | default "IfNotPresent" }}'
        imagePullSecrets:
          {{ .Values.imagePullSecrets | toYaml | nindent 10 }}
{{ if eq .Environment.Name "remote" }}
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # un Keycloak dev a singolo utente (250m saturava da solo quasi tutta
      # l'unica OCPU disponibile insieme ai pod di sistema OKE).
      - resources:
          requests:
            cpu: 150m
      # "command" è una lista: i values Helm non fondono le liste elemento
      # per elemento, vanno ridichiarate per intero per cambiare solo
      # --hostname. Il browser raggiunge Keycloak tramite l'IP pubblico
      # riservato (network.tf), non più "localhost" - l'issuer nei token
      # deve rifletterlo, altrimenti oauth2-proxy lo rifiuta per mismatch.
      - command:
          - "/opt/keycloak/bin/kc.sh"
          - "start"
          - "--import-realm"
          - '--hostname=http://{{ env "OCI_LB_IP" | default "localhost" }}'
          - "--hostname-strict=false"
{{ end }}
    # Cold-pull immagine ~250MB (~4min su rete locale lenta) + avvio
    # (schema DB, import realm, ~60-90s in condizioni normali, ma osservato
    # fino a superare 480s sotto carico di sistema sostenuto), vedi
    # docs/adr/0002-helmfile-orchestration.md.
    timeout: 600
    hooks:
      # Analogo agli hook di user-service/user-frontend: Secret di pull GHCR
      # (namespace "auth", qui - i Secret sono namespace-scoped) e build+load
      # locale dell'immagine one-piece-keycloak-theme (repo sibling), no-op
      # fuori dall'ambiente "default" - vedi docs/adr/0010.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/create-ghcr-pull-secret.sh", "auth"]
      - events: ["presync"]
        command: "bash"
        args: ["scripts/build-and-load-local-image.sh", "one-piece-keycloak-theme"]
      # La ConfigMap del realm deve esistere ed essere aggiornata prima che
      # il chart venga sincronizzato, perché Keycloak la monta e la importa
      # all'avvio (--import-realm).
      - events: ["presync"]
        command: "bash"
        args: ["scripts/apply-realm-configmap.sh"]
      # Riconcilia il realm con realm-onepiece.json via keycloak-config-cli:
      # "--import-realm" da solo crea le entità mancanti ma non aggiorna un
      # realm già esistente (bug noto, vedi il commento in apply-realm-configmap.sh)
      # - questo hook chiude quel gap per ogni futura modifica al realm
      # dichiarativo, non solo per quelle già note ai tre hook sotto (che
      # restano per SMTP/redirect URI specifici dell'ambiente, non presenti
      # nel JSON) - vedi docs/adr/0011-keycloak-config-cli-realm-sync.md.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/sync-realm-config.sh"]
      # Il realm importato punta già all'host SMTP di Resend (vedi
      # keycloak/realm-onepiece.json), ma senza credenziale - un segreto non
      # va committato. Questo hook imposta la password (RESEND_API_KEY) via
      # Admin API dopo l'import in "default"/"remote" (ADR-0007); in "ci"
      # punta invece il realm a Mailpit (ADR-0008) - a differenza dell'hook
      # sopra, qui serve Keycloak già pronto.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-realm-smtp.sh"]
      # Restringe il permesso di modifica di "email" al solo ADMIN sullo
      # User Profile (vedi scripts/configure-user-profile.sh) - stesso
      # motivo dell'hook sopra: non affidabile via import del realm.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-user-profile.sh"]
      # Solo in "remote": il redirect URI del client "onepiece-proxy" nel
      # realm importato resta fisso su "localhost" - va corretto per l'IP
      # pubblico riservato via Admin API (stesso motivo dei due hook sopra:
      # "--import-realm" non aggiorna un client già esistente).
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-remote-redirect-uris.sh"]
      # Porta i permessi roles:read/roles:assign/roles:manage e i grant del
      # service account in linea con realm-onepiece.json su un realm già
      # esistente (stesso motivo dei tre hook sopra) - vedi il commento in
      # testa allo script per il dettaglio di cosa corregge e perché.
      - events: ["postsync"]
        command: "bash"
        args: ["scripts/configure-role-catalog-permissions.sh"]

  - name: redis
    namespace: auth
    chart: ./helm/charts/redis
    needs:
      - auth/namespace
{{ if eq .Environment.Name "remote" }}
    values:
      # Nodo Ampere A1 da 1 OCPU/6GB (ADR-0005): request più realistico per
      # una cache che idle a consumo bassissimo, per lasciare margine a Keycloak.
      - resources:
          requests:
            cpu: 30m
{{ end }}
    # Backing store del session storage di oauth2-proxy (ADR-0009): niente
    # cold-pull pesante né readiness lenta, un'immagine alpine minuscola.
    timeout: 60

  - name: oauth2-proxy
    namespace: auth
    chart: oauth2-proxy/oauth2-proxy
    version: 10.7.0
    needs:
      - auth/namespace
      - auth/keycloak
      - auth/redis
      - app/user-service
      - app/user-frontend
    values:
      - oauth2-proxy/values-oauth2-proxy.yaml
{{ if eq .Environment.Name "remote" }}
      # Il browser raggiunge Keycloak/oauth2-proxy tramite l'IP pubblico
      # riservato (network.tf), non "localhost" - solo i campi con cui il
      # browser interagisce direttamente cambiano; redeem-url/oidc-jwks-url
      # restano sul DNS interno (chiamate server-to-server, invariate).
      - extraArgs:
          oidc-issuer-url: 'http://{{ env "OCI_LB_IP" | default "localhost" }}/realms/onepiece'
          login-url: 'http://{{ env "OCI_LB_IP" | default "localhost" }}/realms/onepiece/protocol/openid-connect/auth'
          redirect-url: 'http://{{ env "OCI_LB_IP" | default "localhost" }}/oauth2/callback'
          whitelist-domain: '{{ env "OCI_LB_IP" | default "localhost" }}'
{{ end }}
    timeout: 180
    hooks:
      # Il Secret con client-id/client-secret/cookie-secret deve esistere
      # prima del sync: i values referenziano config.existingSecret.
      - events: ["presync"]
        command: "bash"
        args: ["scripts/generate-oauth2-proxy-secret.sh"]

  # Ingress pubblico (ADR-0005): solo nell'ambiente "remote" ha senso un
  # Load Balancer reale, ma la release resta definita per tutti gli
  # ambienti per semplicità - in "default"/"ci" resta semplicemente inutilizzata
  # (nessun accesso via kubectl port-forward ne viene impattato).
  - name: ingress-namespace
    namespace: ingress-nginx
    chart: ./helm/charts/namespace
    values:
      - name: ingress-nginx
        component: ingress
    timeout: 30

  - name: ingress-nginx
    namespace: ingress-nginx
    chart: ingress-nginx/ingress-nginx
    version: 4.15.1
    needs:
      - ingress-nginx/ingress-namespace
    values:
      - controller:
          service:
            annotations:
              # Always Free: un solo Flexible Load Balancer per tenancy,
              # banda 10 Mbps fissa (min = max) - un max diverso da 10
              # provisiona un LB a pagamento. Vedi docs/adr/0005.
              service.beta.kubernetes.io/oci-load-balancer-shape: "flexible"
              service.beta.kubernetes.io/oci-load-balancer-shape-flex-min: "10"
              service.beta.kubernetes.io/oci-load-balancer-shape-flex-max: "10"
              # Con la topologia a subnet unica (network.tf) il
              # cloud-controller-manager OCI non riesce a dedurla da sé
              # ("a subnet must be specified") - va data esplicitamente.
              # Valore: terraform output -raw subnet_id (terraform/).
              service.beta.kubernetes.io/oci-load-balancer-subnet1: '{{ env "OCI_LB_SUBNET_ID" | default "" }}'
              # IP pubblico riservato (network.tf): senza dominio, gli URL
              # OAuth2 di oauth2-proxy/Keycloak devono puntare a un indirizzo
              # noto in anticipo, non a quello assegnato dinamicamente alla
              # creazione del LB. Valore: terraform output -raw lb_ip.
              oci.oraclecloud.com/reserved-ips: '{{ env "OCI_LB_IP" | default "" }}'
              # Senza questo, il cloud-controller-manager OCI gestisce da sé
              # la security list della subnet e aggiunge le sue regole
              # aperte (0.0.0.0/0) per le porte del Service - annullando la
              # restrizione al solo CIDR autorizzato che imponiamo via
              # Terraform (network.tf). "None" lascia la security list
              # interamente a noi. Osservato accadere di nuovo alla
              # ricreazione del Service (es. per adottare un nuovo IP
              # riservato) se questa annotazione non è già presente.
              service.beta.kubernetes.io/oci-load-balancer-security-list-management-mode: "None"
          # Request più realistico per il nodo Ampere A1 da 1 OCPU/6GB
          # (ADR-0005): questa release è comunque usata solo in "remote",
          # dove il margine di CPU disponibile è stretto.
          resources:
            requests:
              cpu: 50m
              memory: 90Mi
            limits:
              cpu: 300m
              memory: 200Mi
    timeout: 180

  - name: oauth2-proxy-ingress
    namespace: auth
    chart: ./helm/charts/ingress
    needs:
      - auth/oauth2-proxy
      - ingress-nginx/ingress-nginx
{{ if eq .Environment.Name "remote" }}
    values:
      # Il browser deve raggiungere Keycloak direttamente durante il flow
      # OAuth2 (redirect di login su /realms, risorse statiche del tema su
      # /resources) - non solo oauth2-proxy, che gestisce già "/" per
      # frontend/backend (config.upstreams).
      - paths:
          - path: /
            pathType: Prefix
            backendServiceName: oauth2-proxy
            backendServicePort: 4180
          - path: /realms
            pathType: Prefix
            backendServiceName: keycloak-http
            backendServicePort: 8080
          - path: /resources
            pathType: Prefix
            backendServiceName: keycloak-http
            backendServicePort: 8080
{{ end }}
    timeout: 30
