{
  "realm": "onepiece",
  "enabled": true,
  "sslRequired": "none",
  "editUsernameAllowed": true,
  "resetPasswordAllowed": true,
  "loginTheme": "onepiece",
  "internationalizationEnabled": true,
  "supportedLocales": ["it", "en"],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "eventsExpiration": 604800,
  "smtpServer": {
    "host": "smtp.resend.com",
    "port": "587",
    "from": "onboarding@resend.dev",
    "fromDisplayName": "One Piece API",
    "auth": "true",
    "user": "resend",
    "starttls": "true",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full administrative access",
        "composite": true,
        "composites": {
          "client": {
            "onepiece-proxy": ["users:read", "users:invite", "roles:read", "roles:assign", "roles:manage", "access:write", "audit:read"]
          }
        }
      },
      {
        "name": "REVIEWER",
        "description": "Review and approval permissions",
        "composite": false
      },
      {
        "name": "EDITOR",
        "description": "Content editing permissions",
        "composite": false
      },
      {
        "name": "default-roles-onepiece",
        "description": "Keycloak's built-in default role - pinned here with no composites (see ADR-0012) so no realm/client role, including offline_access and uma_authorization, is auto-granted to new users.",
        "composite": true,
        "composites": {}
      }
    ],
    "client": {
      "onepiece-proxy": [
        { "name": "users:read", "description": "List and view crew members" },
        { "name": "users:invite", "description": "Invite a new crew member" },
        { "name": "roles:read", "description": "View the role/permission registry" },
        { "name": "roles:assign", "description": "Assign or revoke a crew member's roles" },
        { "name": "roles:manage", "description": "Create/delete roles and permissions, assign permissions to roles" },
        { "name": "access:write", "description": "Revoke or reactivate a crew member's access" },
        { "name": "audit:read", "description": "Read the ship's log (audit trail)" }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": { "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": {}
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "onepiece-proxy",
      "name": "One Piece oauth2-proxy client",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "onepiece-proxy-change-me-locally",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:4180/oauth2/callback",
        "http://localhost:4180/"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4180/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "user-service-admin",
      "name": "One Piece user-service Keycloak Admin API client",
      "description": "Service-account-only: lets user-service manage accounts via the Admin REST API - user/role reads, invite provisioning, admin-events reads for invitation expiry, role/permission catalog management (roles:manage); see service-account user below.",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "user-service-admin-change-me-locally",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-user-service-admin",
      "enabled": true,
      "serviceAccountClientId": "user-service-admin",
      "clientRoles": {
        "realm-management": ["manage-realm", "view-realm", "view-users", "query-users", "manage-users", "view-events",
          "manage-clients", "view-clients", "query-clients"]
      }
    },
    {
      "id": "446fbe79-5cc4-458d-925d-9934334b6dcf",
      "username": "luffy",
      "email": "luffy@onepiece.local",
      "firstName": "Monkey D.",
      "lastName": "Luffy",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "luffy-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "nami",
      "email": "nami@onepiece.local",
      "firstName": "Nami",
      "lastName": "Cat Burglar",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "nami-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "EDITOR"
      ]
    },
    {
      "username": "zoro",
      "email": "zoro@onepiece.local",
      "firstName": "Roronoa",
      "lastName": "Zoro",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "zoro-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "REVIEWER"
      ]
    },
    {
      "username": "sanji",
      "email": "sanji@onepiece.local",
      "firstName": "Vinsmoke",
      "lastName": "Sanji",
      "emailVerified": true,
      "enabled": false,
      "credentials": [
        {
          "type": "password",
          "value": "sanji-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "EDITOR"
      ]
    },
    {
      "username": "usopp",
      "email": "usopp@onepiece.local",
      "firstName": "Usopp",
      "lastName": "Sniper King",
