{
  "realm": "onepiece",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "smtpServer": {
    "host": "mailpit.auth.svc.cluster.local",
    "port": "1025",
    "from": "onboarding@onepiece.local",
    "fromDisplayName": "One Piece API",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full administrative access" },
      { "name": "REVIEWER", "description": "Review and approval permissions" },
      { "name": "EDITOR", "description": "Content editing permissions" }
    ]
  },
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": { "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": {}
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "onepiece-proxy",
      "name": "One Piece oauth2-proxy client",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "onepiece-proxy-change-me-locally",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:4180/oauth2/callback",
        "http://localhost:4180/"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4180/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "user-service-admin",
      "name": "One Piece user-service Keycloak Admin API client",
      "description": "Service-account-only: lets user-service manage user accounts via the Admin REST API - reads user/role data for the admin listing (UF-IDU-17, Step 3), and creates/provisions accounts for invitations (UF-IDU-01, Step 4), see the service-account user below.",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "user-service-admin-change-me-locally",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-user-service-admin",
      "enabled": true,
      "serviceAccountClientId": "user-service-admin",
      "clientRoles": {
        "realm-management": ["view-realm", "view-users", "query-users", "manage-users"]
      }
    },
    {
      "id": "446fbe79-5cc4-458d-925d-9934334b6dcf",
